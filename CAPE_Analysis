   "source": [
    "# Calculate a CAPE Risk Score per period\n",
    "# High carbon intensity + high overstock = high risk\n",
    "\n",
    "cape_summary['overstock_pct'] = cape_summary['overstock_co2e'] / cape_summary['total_co2e']\n",
    "\n",
    "# Normalize both metrics 0-1 and combine into a risk score\n",
    "from sklearn.preprocessing import MinMaxScaler\n",
    "\n",
    "scaler = MinMaxScaler()\n",
    "cape_summary['intensity_scaled'] = scaler.fit_transform(cape_summary[['co2e_per_dollar']])\n",
    "cape_summary['overstock_scaled'] = scaler.fit_transform(cape_summary[['overstock_co2e']])\n",
    "\n",
    "# CAPE Risk Score: 70% carbon intensity + 30% overstock penalty\n",
    "cape_summary['cape_risk_score'] = (\n",
    "    cape_summary['intensity_scaled'] * 0.70 +\n",
    "    cape_summary['overstock_scaled'] * 0.30\n",
    ")\n",
    "\n",
    "print(\"CAPE Risk Scores by Period:\")\n",
    "print(cape_summary[['period', 'total_revenue', 'co2e_per_dollar', 'overstock_co2e', 'cape_risk_score']]\n",
    "      .sort_values('cape_risk_score', ascending=False)\n",
    "      .head(10)\n",
    "      .to_string())"
   ]
