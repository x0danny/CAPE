    "# Sort by period order for the chart\n",
    "cape_summary_sorted = cape_summary.sort_values(['SIM_ROUND', 'SIM_STEP'])\n",
    "\n",
    "fig2 = px.bar(cape_summary_sorted,\n",
    "              x='period',\n",
    "              y='cape_risk_score',\n",
    "              color='cape_risk_score',\n",
    "              color_continuous_scale='RdYlGn_r',\n",
    "              title='CAPE Risk Score by Simulation Period',\n",
    "              labels={'cape_risk_score': 'Risk Score (0-1)', 'period': 'Period'})\n",
    "\n",
    "fig2.add_hline(y=0.6, line_dash='dash', line_color='red', \n",
    "               annotation_text='High Risk Threshold')\n",
    "\n",
    "fig2.update_layout(xaxis_tickangle=45)\n",
    "fig2.show()"
   ]
