   "source": [
    "# Join Sales and Carbon on SIM_ROUND and SIM_STEP\n",
    "cape_join = pd.merge(sales, carbon, on=['SIM_ROUND', 'SIM_STEP'], how='inner')\n",
    "\n",
    "print(\"Joined rows:\", len(cape_join))\n",
