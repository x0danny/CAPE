# CAPE AI Chat — API keys
# Copy this file to .env and fill in your keys.
# Add the same keys to Streamlit Cloud secrets (Settings > Secrets) for the live site.

# LLM keys (Groq is primary, Gemini is fallback — both free tier)
GROQ_API_KEY=your_groq_key_here
GEMINI_API_KEY=your_google_ai_studio_key_here

# Web search — enables live current events answers and CAPE+external hybrid questions
# Free tier: 1,000 searches/month — sign up at https://tavily.com
TAVILY_API_KEY=your_tavily_key_here
